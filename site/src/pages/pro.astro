---
// Echo Pro product page: a commercial Go library from LabStack that builds on
// Echo v5. Rendered inside Starlight so it keeps the site header, footer and
// theme. Code-library product pattern: hero with real code, trust row, request
// path, package table, pricing, install, FAQ. Every snippet is trimmed from the
// echo-pro package READMEs and must keep matching their APIs.
// Buying is by email until checkout launches; noindex until then.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';
import consoleDark from '../assets/pro/admin-console-dark.webp';
import consoleLight from '../assets/pro/admin-console-light.webp';

// The release site owns /pro; the next preview sends visitors there.
if (process.env.DOCS_CHANNEL === 'next') return Astro.redirect('/pro');

// Flip to true at launch (with indexing) to emit SoftwareApplication + Offer JSON-LD.
const ENABLE_STRUCTURED_DATA = false;
// Set to an absolute URL (1200x630) to give /pro its own social card.
const OG_IMAGE: string | undefined = undefined;

const buy = (plan: string) =>
  `mailto:support@labstack.com?subject=${encodeURIComponent(`Buy Echo Pro ${plan}`)}`;

// Trimmed from auth/README.md (quickstart) and auth/authbind/README.md.
// apiKey is the quickstart's auth.APIKey scheme (store, prefix and peppers).
const authSnippet = `authCfg := auth.Config{
	Schemes: map[string]auth.Scheme{"key": apiKey},
	Fallback: auth.Require(map[string][]string{
		"key": {"invoice:read"},
	}),
}
guard, err := authbind.Middleware(authCfg, tenant.Config{
	Selectors: []tenant.Selector{tenant.FromCredential()},
	Required:  true,
})
e.Group("/v1", guard).GET("/invoices", listInvoices)`;

// Trimmed from quota/README.md (five-minute quickstart) and auth/authbind.
const quotaSnippet = `lim, err := quota.New(quota.Config{
	Store: quota.NewMemoryStore(quota.MemoryConfig{}),
	Plans: []quota.Plan{{ID: "free", Limits: []quota.Limit{
		quota.PerSecond("burst", 5).Burst(10),
		quota.PerMonth("requests", 10_000),
	}}},
})
identity, err := authbind.Quota()
mw, err := quota.MiddlewareConfig{
	Limiter: lim, Identity: identity,
}.ToMiddleware() // explained 429s
e.Group("/v1", guard, mw).GET("/hello", hello)`;

// Trimmed from webhook/README.md (memory round trip).
const webhookSnippet = `p, err := webhook.PrepareOutgoing(webhook.Outgoing{
	Tenant: "t1", Destination: "credits", Version: "v1",
	Key: "invoice_42/grant", Type: "credit.add", Format: "json",
	Payload: []byte(\`{"amount":100}\`),
})
receipt, err := store.Enqueue(ctx, p)
worker, err := webhookmem.NewWorker(store,
	webhookmem.WorkerConfig{})
go func() { done <- worker.Run(ctx) }() // signs and delivers`;

const tabs = [
  { id: 'auth', label: 'Auth + tenant', code: authSnippet },
  { id: 'quota', label: 'Quota', code: quotaSnippet },
  { id: 'webhook', label: 'Webhooks', code: webhookSnippet },
];

// Plain text, plus a package path (the only part set in mono) where one applies.
const requirements: Array<{ text: string; pkg?: string }> = [
  { text: 'Go 1.26 and 1.27' },
  { text: 'Echo v5.4.2 or later' },
  { text: 'PostgreSQL 16–18' },
  { text: 'Redis or Valkey (optional) for', pkg: 'quota/redisstore' },
];

const trust = [
  ['No telemetry', 'The library sends nothing anywhere by itself.'],
  ['No license checks at run time', 'Your token only downloads modules.'],
  ['Keep what you bought', 'Versions you received stay licensed after you stop paying.'],
  ['Plain go get', 'A private Go module proxy and your go.sum.'],
];

const flagships = [
  {
    title: 'Auth and tenant isolation',
    packages: 'auth · tenant · auth/authbind',
    text: 'Every request carries a verified API key or JWT and a resolved tenant, or it is refused. Conflicting tenant sources fail closed; Static, Casbin, Cerbos and OpenFGA authorizers deny by default.',
  },
  {
    title: 'Quotas, AI and MCP metering, Stripe',
    packages: 'quota · quota/quotamcp · quota/quotastripe',
    text: 'Enforce per-tenant plans with an explained 429, reserve and settle AI usage, meter MCP tools, and export final consumption to Stripe meters with receipts and reconciliation.',
  },
  {
    title: 'Embedded admin console',
    packages: 'admin',
    text: 'Plans, usage, credits, denials, audit, webhooks and execution records in one console mounted behind your own sign-in. Changes are previewed, confirmed and audited.',
    console: true,
  },
];

const packages = [
  ['auth', 'API keys and asymmetric JWT access tokens, one credential per request.'],
  ['tenant', 'Tenant resolution with membership checks and deny-by-default authorizers.'],
  ['auth/authbind', 'Maps verified identity into quota, audit, execution, admin and MCP.'],
  ['quota', 'Per-tenant plans, weighted costs, credits, concurrency limits and Echo middleware.'],
  ['quota/redisstore', 'Atomic Redis and Valkey store: standalone, Sentinel and Cluster.'],
  ['quota/quotamcp', 'Plan quotas and metering for MCP tools on the official MCP Go SDK.'],
  ['quota/quotastripe', 'Stripe meter export of final usage, with receipts and reconciliation.'],
  ['quota/quotaclient', 'Client-side RateLimit parsing, problems and polite retries.'],
  ['quota/quotaprom, quota/quotaotel', 'Opt-in Prometheus and OpenTelemetry hooks into your own systems.'],
  ['audit, audit/auditpg', 'Durable business audit events with redaction, recorded in PostgreSQL 16–18.'],
  ['execution, execution/pgstore', 'Records of declared external effects, with operator recovery.'],
  ['webhook, webhook/webhookpg', 'Signed inbox and outbox, retry workers and replay, durable on PostgreSQL.'],
  ['openapi', 'Operation-policy coverage reports and an ordered auth, quota and validation chain.'],
  ['problem', 'RFC 9457 problem catalog and Echo error rendering.'],
  ['redact', 'Input classification and bounded projection of stored evidence.'],
  ['admin', 'The embedded console, with panels for every package above.'],
  ['cmd/quota', 'Command line for plan checks, usage, resets, credits, keys and the outbox.'],
];

const founding = 'Founding price with code FOUNDING for the first 25 organisations, on the first three annual invoices, until 31 Mar 2027.';
const plans = [
  {
    name: 'Echo', price: 'Free', unit: 'MIT license', note: 'For every Go team',
    items: ['The Echo framework and built-in middleware', 'echo-jwt, echo-otel, echo-prometheus, echo-contrib', 'Community support on GitHub'],
    cta: { label: 'Get started', href: '/guide/quickstart/', primary: false },
  },
  {
    name: 'Team', was: '$1,500', price: '$990', unit: '/ year', note: 'Up to 20 developers',
    items: ['Everything in Echo', 'Every Echo Pro package', 'Every release while subscribed', 'Access tokens for go.labstack.io'],
    cta: { label: 'Buy Team by email', href: buy('Team'), primary: true },
  },
  {
    name: 'Business', was: '$4,500', price: '$2,970', unit: '/ year', note: 'Up to 100 developers',
    items: ['Everything in Team'],
    cta: { label: 'Buy Business by email', href: buy('Business'), primary: false },
  },
];

// ✓ = true, — = false, strings render as-is.
const comparison: Array<[string, Array<[string, ...Array<boolean | string>]>]> = [
  ['Packages', [
    ['Echo framework and built-in middleware', true, true, true],
    ['Official packages (echo-jwt, echo-otel, echo-prometheus, echo-contrib)', true, true, true],
    ['Echo Pro packages', false, true, true],
  ]],
  ['Developers', [
    ['Developers per organisation', 'Any', 'Up to 20', 'Up to 100'],
  ]],
  ['Updates', [
    ['New releases', true, 'While subscribed', 'While subscribed'],
    ['Keep received versions after the subscription ends', true, true, true],
    ['Security fixes on owned release lines after it ends', false, true, true],
  ]],
  ['Support', [
    ['Community support on GitHub', true, true, true],
    ['Support contract ($4,900 / year)', false, 'Separate', 'Separate'],
  ]],
  ['Billing', [
    ['Price', 'Free', '$1,500 / year', '$4,500 / year'],
    ['Founding price with FOUNDING', false, '$990 / year', '$2,970 / year'],
    ['Billing', false, 'Annual', 'Annual'],
  ]],
];

const ciSnippet = `- name: Configure Echo Pro
  run: |
    go env -w GOPRIVATE=echo.labstack.com
    umask 077
    grep -qs '^machine go.labstack.io ' ~/.netrc ||
      echo "machine go.labstack.io login <org> password \${{ secrets.ECHO_PRO_TOKEN }}" >> ~/.netrc`;

const faq = [
  ['What stays free?', 'Echo, its built-in middleware and the official packages (echo-jwt, echo-otel, echo-prometheus and echo-contrib) are open source under the MIT license. Echo Pro is a separate module that builds on them.'],
  ['Is Echo going closed source?', 'No. Echo stays open source under the MIT license. Echo Pro is a separate module that builds on Echo and does not change its license.'],
  ['Why paid?', 'Echo Pro is a large body of maintained code: auth, tenant isolation, quotas and durable stores tested against PostgreSQL 16–18, Redis and Valkey. Subscriptions pay for that work and fund Echo\'s maintenance.'],
  ['What license is Echo Pro under?', 'The Echo Pro commercial license. While subscribed, your organisation may use, copy and modify it and include it in its own applications and services, including programs it distributes and services it operates. It may not pass the source code to third parties or offer it as a standalone library or competing product.'],
  ['Does Echo Pro send telemetry or check a license at run time?', 'No. The library sends nothing anywhere by itself and never checks a key. Metrics and tracing are opt-in hooks into your own systems.'],
  ['What happens when the subscription ends?', 'You keep the versions you already have, plus security fixes on the release lines you owned. New versions need an active subscription.'],
  ['Can we evaluate before buying, or get a refund?', 'There is no free trial. This page, the package list and the code samples show what you get. If Echo Pro is not right for you, you get a full refund within 30 days of purchase.'],
  ['Invoices and purchase orders?', 'Team and Business are billed annually per organisation. Support and Enterprise are invoiced annually. Email support@labstack.com for billing details your company needs.'],
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Echo Pro',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  description: 'Commercial Go library for Echo v5: auth, tenant isolation, quotas and AI/MCP metering, audit, execution records, webhooks and an embedded admin console.',
  url: 'https://echo.labstack.com/pro',
  publisher: { '@type': 'Organization', name: 'LabStack LLC', url: 'https://labstack.com' },
  offers: [
    { '@type': 'Offer', name: 'Team', price: '1500', priceCurrency: 'USD', url: 'https://echo.labstack.com/pro#pricing' },
    { '@type': 'Offer', name: 'Business', price: '4500', priceCurrency: 'USD', url: 'https://echo.labstack.com/pro#pricing' },
  ],
};

const head = [
  { tag: 'title', content: 'Echo Pro — Multi-tenant building blocks for Echo v5' },
  { tag: 'meta', attrs: { name: 'robots', content: 'noindex' } },
  ...(OG_IMAGE ? [
    { tag: 'meta', attrs: { property: 'og:image', content: OG_IMAGE } },
    { tag: 'meta', attrs: { name: 'twitter:image', content: OG_IMAGE } },
  ] : []),
  ...(ENABLE_STRUCTURED_DATA ? [
    { tag: 'script', attrs: { type: 'application/ld+json' }, content: JSON.stringify(structuredData) },
  ] : []),
];
---

<StarlightPage
  frontmatter={{
    title: 'Echo Pro',
    description: 'Echo Pro is a commercial Go library from LabStack for Echo v5: auth, tenant isolation, quotas and AI/MCP metering, audit, execution records, webhooks, OpenAPI policy coverage and an embedded admin console.',
    template: 'splash',
    tableOfContents: false,
    pagefind: false,
    editUrl: false,
    lastUpdated: false,
    // The page title folds into the hidden hero region, as on the home page.
    hero: { tagline: ' ' },
    head,
  }}
>
  <div class="pro not-content">
    <section class="pro-hero" aria-labelledby="pro-title">
      <div class="pro-hero-copy">
        <h1 id="pro-title">Multi-tenant APIs on Echo v5, without building the plumbing.</h1>
        <p class="pro-lead">
          Auth, tenant isolation, quotas, audit, webhooks and an admin console in one commercial
          Go module from LabStack. Mount it in your own Echo app and install it with the standard Go toolchain.
        </p>
        <div class="pro-actions">
          <a class="hh-btn pri" href="#pricing">See pricing</a>
          <a class="hh-btn sec" href="#docs">Read the docs</a>
        </div>
        <ul class="pro-chips" aria-label="Requirements">
          {requirements.map(({ text, pkg }) => <li><span>{text}{pkg && <> <code>{pkg}</code></>}</span></li>)}
        </ul>
      </div>

      <div class="pro-tabs" data-tabs>
        <div class="pro-tablist" role="tablist" aria-label="Echo Pro code samples" hidden data-tablist>
          {tabs.map((tab, i) => (
            <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{tab.label}</button>
          ))}
        </div>
        {tabs.map((tab) => (
          <div class="pro-panel" id={`panel-${tab.id}`} role="tabpanel" aria-labelledby={`tab-${tab.id}`} aria-label={tab.label} tabindex="0">
            <Code code={tab.code} lang="go" frame="code" />
          </div>
        ))}
      </div>
    </section>

    <ul class="pro-trust" aria-label="What you can rely on">
      {trust.map(([title, text]) => (
        <li>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span><b>{title === 'Plain go get' ? <>Plain <code>go get</code></> : title}</b> {text}</span>
        </li>
      ))}
    </ul>

    <section id="how" aria-labelledby="how-title">
      <h2 id="how-title">Where it sits in a request</h2>
      <p class="pro-intro">Middleware you mount in order on your own routes. Your handler stays yours; the stores are your PostgreSQL and Redis.</p>
      <figure class="pro-diagram">
        <svg class="d-wide" viewBox="0 28 960 240" role="img" aria-labelledby="dw-title dw-desc">
          <title id="dw-title">Echo Pro request path</title>
          <desc id="dw-desc">A request passes auth (auth/authbind), then tenant resolution, then quota, then reaches your handler. The handler writes audit events, execution records and webhook outbox messages to stores. The admin console reads from those stores.</desc>
          <defs><marker id="dw-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="d-head" /></marker></defs>
          {[
            [20, 'Request', 'HTTP or MCP tool call'],
            [210, 'auth', 'auth/authbind'],
            [400, 'tenant', 'resolve and authorize'],
            [590, 'quota', 'plans, credits, 429'],
          ].map(([x, t, s]) => (
            <g><rect class="d-box" x={x} y="40" width="160" height="64" rx="8" /><text class="d-t" x={Number(x) + 16} y="67">{t}</text><text class="d-s" x={Number(x) + 16} y="88">{s}</text></g>
          ))}
          <g><rect class="d-box d-yours" x="780" y="40" width="160" height="64" rx="8" /><text class="d-t" x="796" y="67">Your handler</text><text class="d-s" x="796" y="88">business logic</text></g>
          {[
            [400, 'audit', 'business events'],
            [590, 'execution', 'external effects'],
            [780, 'webhook outbox', 'signed delivery'],
          ].map(([x, t, s]) => (
            <g><rect class="d-box d-store" x={x} y="190" width="160" height="64" rx="8" /><text class="d-t" x={Number(x) + 16} y="217">{t}</text><text class="d-s" x={Number(x) + 16} y="238">{s}</text></g>
          ))}
          <g><rect class="d-box" x="20" y="190" width="310" height="64" rx="8" /><text class="d-t" x="36" y="217">Admin console</text><text class="d-s" x="36" y="238">behind your own sign-in</text></g>
          <g class="d-flow">
            <path d="M180 72H209" marker-end="url(#dw-arrow)" /><path d="M370 72H399" marker-end="url(#dw-arrow)" /><path d="M560 72H589" marker-end="url(#dw-arrow)" /><path d="M750 72H779" marker-end="url(#dw-arrow)" />
            <path d="M860 104V189" marker-end="url(#dw-arrow)" /><path d="M860 150H480V189" marker-end="url(#dw-arrow)" /><path d="M670 150V189" marker-end="url(#dw-arrow)" />
          </g>
          <path class="d-read" d="M400 222H330" marker-end="url(#dw-arrow)" />
          <text class="d-note" x="365" y="212" text-anchor="middle">reads</text>
        </svg>
        <svg class="d-narrow" viewBox="0 0 320 560" role="img" aria-labelledby="dn-title dn-desc">
          <title id="dn-title">Echo Pro request path</title>
          <desc id="dn-desc">A request passes auth (auth/authbind), then tenant resolution, then quota, then reaches your handler. The handler writes audit events, execution records and webhook outbox messages to stores. The admin console reads from those stores.</desc>
          <defs><marker id="dn-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="d-head" /></marker></defs>
          {[
            [0, 'Request', 'HTTP or MCP tool call', ''],
            [64, 'auth', 'auth/authbind', ''],
            [128, 'tenant', 'resolve and authorize', ''],
            [192, 'quota', 'plans, credits, 429', ''],
            [256, 'Your handler', 'business logic', 'd-yours'],
          ].map(([y, t, s, cls]) => (
            <g><rect class={`d-box ${cls}`} x="20" y={Number(y) + 2} width="280" height="46" rx="8" /><text class="d-t" x="36" y={Number(y) + 22}>{t}</text><text class="d-s" x="36" y={Number(y) + 40}>{s}</text></g>
          ))}
          <g class="d-flow"><path d="M160 49V65" marker-end="url(#dn-arrow)" /><path d="M160 112V129" marker-end="url(#dn-arrow)" /><path d="M160 176V193" marker-end="url(#dn-arrow)" /><path d="M160 240V257" marker-end="url(#dn-arrow)" /><path d="M160 304V335" marker-end="url(#dn-arrow)" /></g>
          <rect class="d-group" x="20" y="336" width="280" height="140" rx="10" />
          {[
            [346, 'audit', 'business events'],
            [388, 'execution', 'external effects'],
            [430, 'webhook outbox', 'signed delivery'],
          ].map(([y, t, s]) => (
            <g><text class="d-t" x="36" y={Number(y) + 18}>{t}</text><text class="d-s" x="36" y={Number(y) + 34}>{s}</text></g>
          ))}
          <path class="d-read" d="M160 512V484" marker-end="url(#dn-arrow)" />
          <text class="d-note" x="172" y="502">reads</text>
          <g><rect class="d-box" x="20" y="512" width="280" height="46" rx="8" /><text class="d-t" x="36" y="532">Admin console</text><text class="d-s" x="36" y="550">behind your own sign-in</text></g>
        </svg>
      </figure>
    </section>

    <section id="features" aria-labelledby="features-title">
      <h2 id="features-title">What's in the box</h2>
      <p class="pro-intro">One module, <code>echo.labstack.com/pro</code>. Runnable examples, tests and package READMEs ship with it.</p>

      <div class="pro-flagships">
        {flagships.map((item) => (
          <article class={`pro-flagship${item.console ? ' has-media' : ''}`}>
            <div class="pro-flagship-copy">
              <h3>{item.title}</h3>
              <p class="pro-pkg">{item.packages}</p>
              <p>{item.text}</p>
            </div>
            {item.console && (
              <figure class="pro-shot">
                <Image class="shot-dark" src={consoleDark} alt="Echo Pro admin console overview: a pipeline from requests through executions, outbox and webhooks to receivers, with event counts for the selected window." width={1600} height={570} loading="lazy" decoding="async" />
                <Image class="shot-light" src={consoleLight} alt="Echo Pro admin console overview: a pipeline from requests through executions, outbox and webhooks to receivers, with event counts for the selected window." width={1600} height={570} loading="lazy" decoding="async" />
                <figcaption>The admin console overview, from the demo catalog.</figcaption>
              </figure>
            )}
          </article>
        ))}
      </div>

      <table class="pro-pkgs">
        <caption class="sr-only">Echo Pro packages</caption>
        <thead><tr><th scope="col">Package</th><th scope="col">What it does</th></tr></thead>
        <tbody>
          {packages.map(([path, text]) => (
            <tr><th scope="row"><code>{path}</code></th><td>{text}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section id="pricing" aria-labelledby="pricing-title">
      <h2 id="pricing-title">Pricing</h2>
      <p class="pro-intro">Billed annually per organisation. Echo stays open source under the MIT license; Echo Pro subscriptions fund its maintenance.</p>

      <div class="pro-plans">
        {plans.map((plan) => (
          <div class={`pro-plan${plan.was ? ' paid' : ''}`}>
            <h3>{plan.name}</h3>
            <p class="pro-price">
              {plan.was && <s><span class="sr-only">Was </span>{plan.was}</s>}
              {plan.was && <span class="sr-only">, now </span>}
              <b>{plan.price}</b> <span class="u">{plan.unit}</span>
            </p>
            <p class="pro-note">{plan.was ? founding : plan.note}</p>
            {plan.was && <p class="pro-seats">{plan.note}</p>}
            <ul class="pro-checks">{plan.items.map((item) => <li>{item}</li>)}</ul>
            <a class={`hh-btn ${plan.cta.primary ? 'pri' : 'sec'}`} href={plan.cta.href}>{plan.cta.label}</a>
          </div>
        ))}
      </div>
      <p class="pro-pending">Online checkout opens at launch. Until then, email us to buy.</p>

      <div class="pro-extra">
        <div>
          <h3>Support</h3>
          <p><b>$4,900</b> / year · A support contract, invoiced annually.</p>
          <a class="pro-link" href="mailto:support@labstack.com?subject=Echo%20Pro%20Support">Contact us</a>
        </div>
        <div>
          <h3>Enterprise</h3>
          <p>From <b>$12,000</b> / year · More than 100 developers, or group companies.</p>
          <a class="pro-link" href="mailto:support@labstack.com?subject=Echo%20Pro%20Enterprise">Contact us</a>
        </div>
      </div>

      <div class="pro-compare-wrap" role="region" aria-label="Compare plans" tabindex="0">
        <table class="pro-compare">
          <caption>Compare plans</caption>
          <thead>
            <tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">Echo</th><th scope="col">Team</th><th scope="col">Business</th></tr>
          </thead>
          {comparison.map(([group, rows]) => (
            <tbody>
              <tr class="grp"><th scope="colgroup" colspan="4">{group}</th></tr>
              {rows.map(([label, ...cells]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {cells.map((cell) => (
                    <td>{cell === true ? <><span aria-hidden="true" class="yes">✓</span><span class="sr-only">Included</span></> : cell === false ? <><span aria-hidden="true" class="no">—</span><span class="sr-only">Not included</span></> : cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>

      <ul class="pro-terms">
        <li>Annual billing only; no monthly plan.</li>
        <li>Full refund within 30 days of purchase.</li>
        <li>Prices exclude tax. Sold to businesses: checkout asks for your company name, and a tax ID where supported.</li>
        <li>After your subscription ends you keep the versions you have, plus security fixes on the release lines you owned.</li>
      </ul>
    </section>

    <section id="install" aria-labelledby="install-title" class="pro-install">
      <h2 id="install-title">Install</h2>
      <p class="pro-intro">After purchase you create your organisation's access token once. Then, on each machine:</p>
      <ol>
        <li><span>Mark the module private. If you already set <code>GOPRIVATE</code>, append <code>,echo.labstack.com</code> to your existing value instead.</span><Code code="go env -w GOPRIVATE=echo.labstack.com" lang="sh" frame="none" wrap /></li>
        <li><span>Add this line to <code>~/.netrc</code> (Windows: <code>%USERPROFILE%\_netrc</code>), mode 600.</span><Code code="machine go.labstack.io login <org> password <token>" lang="text" frame="none" wrap /></li>

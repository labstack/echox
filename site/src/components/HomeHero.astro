---
// Living Terminal hero: code window + a terminal pane showing `curl` and the
// runnable example's response. The pane is static, server-rendered HTML; the
// only motion is a blinking cursor at the next prompt, which CSS stops for
// reduced motion.
import { starsLabel } from '../data/github.ts';
import { Code, LinkButton } from '@astrojs/starlight/components';
import helloWorldSource from '../../../cookbook/hello-world/server.go?raw';
import { sourceSnippet } from '../../plugins/remark-source-code.mjs';
const helloWorldCode = sourceSnippet(helloWorldSource, 'hero', 'cookbook/hello-world/server.go');
---

<section class="hh not-content">
  <div class="hh-left">
    <h1>Build fast Go APIs.<br />Without the bloat.</h1>
    <p class="hh-sub">
      A high-performance, minimalist Go web framework with a zero-allocation
      router, batteries-included middleware and an expressive API.
    </p>
    <div class="hh-cta">
      <LinkButton class="hh-btn pri" href="/guide/quickstart/">Get started</LinkButton>
      <LinkButton class="hh-btn sec" variant="secondary" icon="github" iconPlacement="start" href="https://github.com/labstack/echo" target="_blank" rel="noopener noreferrer">{starsLabel} on GitHub</LinkButton>
    </div>
    <div class="hh-install"><Code code="go get github.com/labstack/echo/v5" lang="bash" frame="none" wrap /></div>
    <p class="hh-pro">Building a multi-tenant API? <a href="/pro" data-ga-event="pro_click" data-ga-placement="home_hero">Echo Pro</a> adds API keys, tenant isolation, quotas and signed webhooks.</p>
  </div>

  <div class="hh-win">
    <Code code={helloWorldCode} lang="go" title="server.go · excerpt" frame="code" wrap />
    <div class="hh-term" aria-hidden="true">
      <div><span class="pr">~/echo $</span> curl localhost:1323</div>
      <div data-out><div class="dim">HTTP/1.1 200 OK</div><div class="response">Hello, World!</div></div>
      <div><span class="pr">~/echo $</span> <span class="hh-cur"></span></div>
    </div>
  </div>
</section>


---
import Default from '@astrojs/starlight/components/Search.astro';
import { Icon } from '@astrojs/starlight/components';
import { labels } from './search-launchpad';
const isNext = process.env.DOCS_CHANNEL === 'next';
const locale = Astro.locals.starlightRoute.locale ?? 'en';
if (!labels[locale]) throw new Error(`Search.astro: add launchpad labels for locale "${locale}"`);
---
<div class="echo-search-row" data-locale={locale}>
  <Default />
  {/* The kapa.ai index covers release docs; next pages use their own Pagefind index. */}
  {!isNext && <button id="echo-ask-ai" class="echo-ask-ai" type="button" aria-label="Ask AI about Echo">
    <Icon name="star" />
    <span class="echo-ask-ai__label">Ask AI</span>
  </button>}
</div>

<script>
  import { launchpadHTML } from './search-launchpad';

  const search = document.querySelector('site-search');
  const locale = document.querySelector<HTMLElement>('.echo-search-row')?.dataset.locale ?? 'en';
  const docsBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}${locale === 'en' ? '' : `/${locale}`}`;
  function inject() {
    const ui = search?.querySelector('.pagefind-ui');
    if (!ui || ui.querySelector('.echo-search-empty')) return !!ui;
    const form = ui.querySelector('.pagefind-ui__form');
    if (!form) return false;
    form.insertAdjacentHTML('afterend', launchpadHTML(locale, docsBase));
    ui.querySelectorAll<HTMLAnchorElement>('.ess-link').forEach((link) => {
      link.addEventListener('click', (event) => {
        // Modified clicks open a new tab or window; keep the palette open for them.
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        search?.querySelector('dialog')?.close();
      });
    });
    return true;
  }

  // Starlight mounts Pagefind on idle — watch its search subtree, then stop.
  if (search && !inject()) {
    const obs = new MutationObserver(() => { if (inject()) obs.disconnect(); });
    obs.observe(search, { childList: true, subtree: true });
    // Bound the observer: if Pagefind never mounts (disabled in dev, or the
    // Starlight markup changed on upgrade), stop watching so it can't run for
    // the page's lifetime. Losing the launchpad is harmless; search still works.
    setTimeout(() => {
      obs.disconnect();
      if (import.meta.env.DEV && !document.querySelector('.echo-search-empty')) {
        console.warn('[search] empty-state panel not injected — .pagefind-ui selectors may have changed');
      }
    }, 10000);
  }
</script>

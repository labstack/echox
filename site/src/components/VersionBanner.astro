---
import pro from '../../pro-source/pro-source.json';
import stable from '../generated/echo-source.json';
import manifest from '../generated/config-fields.json';
import { formatRevision } from '../data/source.mjs';
import { isProPage } from '../pro-page.mjs';
import { Icon } from '@astrojs/starlight/components';

const isNext = process.env.DOCS_CHANNEL === 'next';
const revision = manifest.revision;
const path = Astro.url.pathname;
const locale = path.split('/').find((part) => ['es', 'ja', 'pt-br', 'zh-cn'].includes(part)) || 'en';
const labels = {
  en: { release: 'Release docs', next: 'Next docs', source: 'API source', switch: isNext ? 'View stable' : 'View next' },
  es: { release: 'Documentación estable', next: 'Próxima versión', source: 'Código de la API', switch: isNext ? 'Ver estable' : 'Ver próxima versión' },
  ja: { release: '安定版ドキュメント', next: '次期版ドキュメント', source: 'API ソース', switch: isNext ? '安定版を見る' : '次期版を見る' },
  'pt-br': { release: 'Documentação estável', next: 'Próxima versão', source: 'Código da API', switch: isNext ? 'Ver estável' : 'Ver próxima versão' },
  'zh-cn': { release: '稳定版文档', next: '下一版文档', source: 'API 源码', switch: isNext ? '查看稳定版' : '查看下一版' },
}[locale];
// /pro is a release-site product page, not versioned documentation.
const isProduct = isProPage(path);
// Echo Pro launch note: the English release home only, in place of the
// version strip; it also hides the hero's Pro line (global style below).
// Remove this block and that style by 25 Nov 2026.
const isLaunchHome = !isNext && path === '/';
const counterpart = /\/(?:404|404\.html)\/?$/.test(path)
  ? (isNext ? '/' : '/next/')
  : isNext ? path.replace(/^\/next/, '') || '/' : `/next${path}`;
---

{isLaunchHome && <aside class="echo-version-banner launch" aria-label="Announcement" data-pagefind-ignore>
  <span><strong>New: Echo Pro</strong> — multi-tenant auth, quotas and signed webhooks for Echo&nbsp;v5.<span class="detail"> Founding pricing for the first 25 organisations.</span></span>
  <a class="switch" href="/pro" data-ga-event="pro_click" data-ga-placement="launch_banner">See Echo Pro <Icon name="right-arrow" class="arrow" /></a>
</aside>}

{isProduct && path.replace(/\/$/, '') !== '/pro' && <aside class="echo-version-banner" aria-label="Echo Pro version" data-pagefind-ignore>
  <strong>Echo Pro {pro.version}</strong><span>· Go 1.26+ · Echo v5.4.2</span><a href="/pro/install/">Install</a>
</aside>}

{!isProduct && !isLaunchHome && <nav class="echo-version-banner" aria-label="Documentation version" data-pagefind-ignore>
  <strong>{isNext ? labels.next : `${labels.release} · Echo ${stable.release}`}</strong>
  <span>· {labels.source} <a href={`https://github.com/labstack/echo/tree/${revision}`}>{formatRevision(revision)}</a></span>
  <a class="switch" data-version-switch href={counterpart}>{labels.switch}</a>
</nav>}

<style>
  /* A quiet strip: neutral surface and hairline, with cyan only on the links. */
  .echo-version-banner { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .4rem; padding: .45rem 1rem; background: var(--sl-color-bg-sidebar); border-bottom: 1px solid var(--sl-color-hairline); color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  .echo-version-banner strong { color: var(--sl-color-white); font-weight: 600; }
  .echo-version-banner a { color: var(--echo-cyan-text); text-decoration: underline; text-underline-offset: .15em; }
  .echo-version-banner .switch { margin-inline-start: .7rem; font-weight: 600; }
  /* DM Sans has no arrow glyph; the icon keeps it from falling back to a system font. */
  .echo-version-banner .arrow { display: inline-block; vertical-align: -0.125em; font-size: 1em; }
  .echo-version-banner.launch span { text-align: center; text-wrap: balance; }
  .echo-version-banner a:focus-visible { outline: 2px solid var(--echo-cyan-text); outline-offset: 2px; }
  @media (max-width: 40rem) {
    .echo-version-banner.launch .detail { display: none; }
    .echo-version-banner.launch .switch { margin-inline-start: 0; }
  }
</style>

<style is:global>
  /* The launch note carries the Pro pitch while it runs. */
  body:has(.echo-version-banner.launch) .hh-pro { display: none; }
</style>

---
// The plain "Pro" nav link. /pro exists only on the release site, so the link
// stays absolute (no /next/ base).
import { isProPage } from '../pro-page.mjs';
const current = isProPage(Astro.url.pathname);
---
<a class="echo-nav-pro" href="/pro" aria-current={current ? 'page' : undefined}>Pro</a>

---
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';
import { isProPage } from '../pro-page.mjs';

const year = new Date().getFullYear();
// Echo is MIT; on the Echo Pro page say which product the licence covers.
const isProduct = isProPage(Astro.url.pathname);
---
<Default><slot /></Default>
<footer class="echo-docfoot">
  <span>© {year} LabStack LLC. {isProduct ? 'Echo is released under the MIT License; Echo Pro is commercial software.' : 'Released under the MIT License.'}</span>
  <div class="echo-social">
    <a class="echo-docfoot-pro" href="/pro" data-ga-event="pro_click">Echo Pro</a>
    <a href="https://x.com/labstack" target="_blank" rel="noopener noreferrer" aria-label="LabStack on X">
      <Icon name="x.com" />
    </a>
    <a href="https://github.com/labstack/echo" target="_blank" rel="noopener noreferrer" aria-label="Echo on GitHub">
      <Icon name="github" />
    </a>
  </div>
</footer>

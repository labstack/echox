{
  "name": "echo-docs",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test plugins/*.test.mjs scripts/*.test.mjs",
    "dev": "npm run source:prepare && astro dev",
    "build": "node scripts/build-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "source:prepare": "node scripts/prepare-echo-source.mjs",
    "source:check": "npm run source:prepare && node scripts/check-source.mjs && npm run pro:check",
    "cookbook:check": "node scripts/check-cookbook.mjs",
    "source:accept": "node scripts/accept-source.mjs",
    "translations:status": "node scripts/translation-status.mjs",
    "translations:accept": "node scripts/accept-translations.mjs",
    "security-translations:status": "node scripts/security-translation-status.mjs",
    "security-translations:accept": "node scripts/security-translation-status.mjs --accept",
    "site:check": "node scripts/check-site.mjs && node scripts/check-pro-site.mjs",
    "site:accept": "node scripts/check-site.mjs --accept",
    "performance:check": "node scripts/check-performance.mjs",
    "performance:accept": "node scripts/check-performance.mjs --accept",
    "pro:check": "node scripts/pro-source.mjs",
    "pro:accept": "node scripts/pro-source.mjs --accept",
    "pro:prepare": "node scripts/pro-source.mjs --prepare"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.7",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "astro": "^7.4.2",
    "decode-named-character-reference": "1.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/internal-helpers": "0.13.0"
  }
}
